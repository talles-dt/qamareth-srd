---
import Sigil from '../components/Sigil.astro';
import '../styles/global.css';

interface NavItem {
  href: string;
  label: string;
  sub?: NavItem[];
}

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title?: string;
  description?: string;
  section?: string;
  navItems?: NavItem[];
  breadcrumb?: Crumb[];
  frontmatter?: {
    title?: string;
    description?: string;
    section?: string;
    nav?: string;
  };
}

const {
  title: propTitle,
  description: propDescription,
  section: propSection,
  navItems = [],
  breadcrumb = [],
  frontmatter,
} = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const title = frontmatter?.title ?? propTitle ?? 'Qamareth';
const description =
  frontmatter?.description ??
  propDescription ??
  'Sistema de fantasia arcano-musical — harmonia, fé, intriga e poder territorial.';
const section = frontmatter?.section ?? frontmatter?.nav ?? propSection ?? '';
const fullTitle = title.includes('Qamareth') ? title : `${title} · Qamareth`;

const globalNav = [
  { href: '/srd', label: 'SRD' },
  { href: '/lore', label: 'Lore' },
  { href: '/grimorios', label: 'Grimórios' },
  { href: '/templates', label: 'Templates' },
];

const defaultBreadcrumb =
  breadcrumb.length > 0
    ? breadcrumb
    : [
        { label: 'Início', href: '/' },
        section ? { label: section.charAt(0).toUpperCase() + section.slice(1), href: `/${section}` } : null,
        { label: title },
      ].filter(Boolean);

const navLabel = navItems[0]?.label ?? (section ? section.toUpperCase() : 'Codex');

const isActive = (href: string) => {
  const normalized = href.replace(/\/$/, '') || '/';
  return currentPath === normalized;
};
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="generator" content={Astro.generator} />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
</head>
<body>
  <header class="site-nav">
    <nav class="nav-inner">
      <a href="/" class="nav-logo" aria-label="Qamareth — início">
        <Sigil size={36} animate={false} />
        <span class="nav-logo-text font-cinzel-d">Qamareth</span>
      </a>

      <ul class="nav-links" role="list">
        {globalNav.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                'nav-link',
                'font-cinzel',
                (section === link.href.slice(1) || currentPath.startsWith(link.href)) && 'nav-link--active',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <button class="nav-toggle" aria-label="Menu" id="nav-toggle" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </nav>
    <div class="nav-line" aria-hidden="true"><div class="nav-line-diamond"></div></div>
  </header>

  <main class="content-shell">
    {navItems.length > 0 && (
      <aside class="content-sidebar">
        <div class="sidebar-header font-cinzel">{navLabel}</div>
        <nav class="sidebar-nav" aria-label="Navegação da seção">
          {navItems.map((item) => (
            <div class="sidebar-group">
              <a
                href={item.href}
                class:list={['sidebar-link', 'font-garamond', isActive(item.href) && 'sidebar-link--active']}
              >
                {item.label}
              </a>
              {item.sub && item.sub.length > 0 && (
                <div class="sidebar-subnav">
                  {item.sub.map((child) => (
                    <a
                      href={child.href}
                      class:list={[
                        'sidebar-link',
                        'sidebar-link--child',
                        'font-garamond',
                        isActive(child.href) && 'sidebar-link--active',
                      ]}
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              )}
            </div>
          ))}
        </nav>
      </aside>
    )}

    <section class="content-main">
      <nav class="breadcrumb font-cinzel" aria-label="Localização">
        <a href="/" class="breadcrumb-link">Início</a>
        {defaultBreadcrumb.map((crumb) => (
          <>
            <span class="breadcrumb-sep" aria-hidden="true">›</span>
            {crumb.href
              ? <a href={crumb.href} class="breadcrumb-link">{crumb.label}</a>
              : <span class="breadcrumb-current">{crumb.label}</span>
            }
          </>
        ))}
      </nav>

      <article class="prose">
        <slot />
      </article>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <a href="/" class="footer-logo" aria-label="Início">
        <Sigil size={28} animate={false} />
      </a>
      <div class="footer-text font-garamond">
        <span>Qamareth SRD</span>
        <span class="footer-sep" aria-hidden="true">·</span>
        <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener" class="footer-license">
          Licença CC BY 4.0
        </a>
        <span class="footer-sep" aria-hidden="true">·</span>
        <a href="https://oliceu.com" target="_blank" rel="noopener" class="footer-home">oliceu.com</a>
      </div>
    </div>
  </footer>

  <script>
    const toggle = document.getElementById('nav-toggle');
    const navLinks = document.querySelector('.nav-links');
    if (toggle && navLinks) {
      toggle.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        navLinks.classList.toggle('nav-links--open', !open);
      });
    }
  </script>
</body>
</html>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(6, 7, 13, 0.9);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .nav-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 24px;
    min-height: 62px;
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex-shrink: 0;
  }

  .nav-logo-text {
    font-size: 1.05rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--gold-bright);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 6px;
    list-style: none;
    margin-left: auto;
  }

  .nav-link {
    padding: 6px 14px;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-muted);
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }

  .nav-link:hover,
  .nav-link--active {
    color: var(--gold);
    border-color: var(--border);
    background: var(--gold-ghost);
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 6px;
    margin-left: auto;
  }

  .nav-toggle span {
    display: block;
    width: 22px;
    height: 1.5px;
    background: var(--gold-dim);
    border-radius: 2px;
  }

  .nav-line {
    position: relative;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--gold-border) 20%, var(--gold-border) 80%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nav-line-diamond {
    width: 6px;
    height: 6px;
    background: var(--gold-dim);
    transform: rotate(45deg);
    position: absolute;
  }

  .content-shell {
    max-width: 1180px;
    margin: 0 auto;
    padding: 42px 24px 24px;
    display: grid;
    grid-template-columns: minmax(190px, 240px) minmax(0, 1fr);
    gap: 42px;
    min-height: calc(100vh - 150px);
  }

  .content-main {
    min-width: 0;
  }

  .content-sidebar {
    position: sticky;
    top: 90px;
    align-self: start;
    border-right: 1px solid var(--border);
    padding-right: 20px;
    max-height: calc(100vh - 120px);
    overflow: auto;
  }

  .sidebar-header {
    color: var(--gold-dim);
    font-size: 0.62rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .sidebar-group {
    display: grid;
    gap: 3px;
  }

  .sidebar-subnav {
    display: grid;
    gap: 3px;
    margin: 3px 0 14px;
  }

  .sidebar-link {
    display: block;
    color: var(--text-muted);
    padding: 5px 0;
    font-size: 0.98rem;
    line-height: 1.3;
    transition: color 0.2s;
  }

  .sidebar-link--child {
    padding-left: 14px;
    font-size: 0.92rem;
    color: var(--text-faint);
    border-left: 1px solid var(--border-2);
  }

  .sidebar-link:hover,
  .sidebar-link--active {
    color: var(--gold);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 0.6rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 28px;
  }

  .breadcrumb-link {
    color: var(--text-faint);
    transition: color 0.2s;
  }

  .breadcrumb-link:hover {
    color: var(--gold-dim);
  }

  .breadcrumb-sep {
    opacity: 0.4;
  }

  .breadcrumb-current {
    color: var(--gold-dim);
  }

  .prose {
    max-width: 760px;
  }

  .prose :global(h1) {
    font-family: 'Cinzel Decorative', serif;
    font-size: clamp(1.7rem, 4vw, 2.6rem);
    font-weight: 400;
    color: var(--gold-bright);
    letter-spacing: 0.06em;
    margin: 0 0 10px;
    line-height: 1.2;
  }

  .prose :global(h2) {
    font-family: 'Cinzel', serif;
    font-size: 1rem;
    font-weight: 600;
    color: var(--gold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 44px 0 14px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }

  .prose :global(h3) {
    font-family: 'Cinzel', serif;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 28px 0 10px;
  }

  .prose :global(h4) {
    font-family: 'EB Garamond', serif;
    font-size: 1.05rem;
    font-style: italic;
    font-weight: 500;
    color: var(--text-muted);
    margin: 20px 0 6px;
  }

  .prose :global(p) {
    font-size: 1.05rem;
    line-height: 1.85;
    color: var(--text-muted);
    margin: 0 0 14px;
  }

  .prose :global(strong) { color: var(--text); font-weight: 600; }
  .prose :global(em) { color: var(--gold-dim); font-style: italic; }

  .prose :global(a) {
    color: var(--gold-dim);
    border-bottom: 1px solid var(--gold-border);
    transition: color 0.2s, border-color 0.2s;
  }

  .prose :global(a:hover) {
    color: var(--gold);
    border-bottom-color: var(--gold-dim);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 16px;
    padding-left: 20px;
    color: var(--text-muted);
    line-height: 1.8;
  }

  .prose :global(li) { margin-bottom: 5px; }
  .prose :global(li::marker) { color: var(--gold-dim); }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 20px 0;
    font-size: 0.95rem;
  }

  .prose :global(th) {
    font-family: 'Cinzel', serif;
    font-size: 0.62rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--gold);
    text-align: left;
    padding: 9px 12px;
    border-bottom: 1px solid var(--border);
  }

  .prose :global(td) {
    padding: 9px 12px;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border-2);
    vertical-align: top;
  }

  .prose :global(code) {
    font-family: monospace;
    font-size: 0.88em;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 1px 6px;
    color: var(--gold-dim);
  }

  .prose :global(.tagline) {
    display: block;
    color: var(--gold-dim);
    font-style: italic;
    font-size: 1.15rem;
    line-height: 1.55;
    margin: 0 0 26px;
  }

  .prose :global(.divider) {
    color: var(--gold-dim);
    text-align: center;
    margin: 34px 0;
    opacity: 0.75;
  }

  .prose :global(.callout),
  .prose :global(.stat-block),
  .prose :global(.info-card) {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px 18px;
    margin: 18px 0;
    color: var(--text-muted);
  }

  .prose :global(.callout) {
    border-left: 3px solid var(--gold-dim);
    font-style: italic;
  }

  .prose :global(.stat-block h3),
  .prose :global(.stat-block h4) {
    margin-top: 0;
  }

  .prose :global(.card-grid) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 20px 0 26px;
  }

  .prose :global(.info-card) {
    margin: 0;
  }

  .prose :global(.info-card-title) {
    display: block;
    color: var(--gold);
    font-family: 'Cinzel', serif;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 6px;
  }

  .site-footer {
    border-top: 1px solid var(--border-2);
    padding: 28px 24px;
    margin-top: 56px;
  }

  .footer-inner {
    max-width: 1180px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .footer-logo {
    opacity: 0.45;
    flex-shrink: 0;
  }

  .footer-text {
    font-size: 0.88rem;
    color: var(--text-faint);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  .footer-license,
  .footer-home {
    color: var(--text-faint);
  }

  @media (max-width: 860px) {
    .content-shell {
      display: block;
      padding-top: 28px;
    }

    .content-sidebar {
      position: static;
      border-right: 0;
      border-bottom: 1px solid var(--border);
      padding: 0 0 18px;
      margin-bottom: 28px;
      max-height: none;
    }

    .sidebar-subnav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .nav-toggle { display: flex; }

    .nav-links {
      display: none;
      position: absolute;
      top: 63px;
      left: 0;
      right: 0;
      background: rgba(6, 7, 13, 0.97);
      backdrop-filter: blur(20px);
      flex-direction: column;
      align-items: stretch;
      padding: 12px 16px 20px;
      border-bottom: 1px solid var(--border);
      gap: 4px;
    }

    .nav-links--open { display: flex; }
    .nav-link { padding: 10px 16px; font-size: 0.8rem; }
    .sidebar-subnav { grid-template-columns: 1fr; }
    .prose :global(.card-grid) { grid-template-columns: 1fr; }
  }
</style>
